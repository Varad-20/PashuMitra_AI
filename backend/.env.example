PORT=5000
# Leave MONGODB_URI empty to run the frontend in demo mode (localStorage)
MONGODB_URI=mongodb://127.0.0.1:27017/pashumitra
# Optional: Gemini API key for the AI Health Assistant (rule-based fallback is used if missing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
CLIENT_URL=http://localhost:5173
