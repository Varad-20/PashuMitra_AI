# Optional: Override the API base URL (defaults to '/api' which Vite proxies to VITE_BACKEND_PROXY_TARGET)
# When deploying frontend & backend on separate hosts or accessing directly from a mobile device without proxy:
# VITE_API_URL=http://192.168.1.100:5000/api
VITE_API_URL=/api
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5000
VITE_FORCE_DEMO=false
